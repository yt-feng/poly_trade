{
  "blocked_reasons": [
    "missing_observation_file",
    "missing_label_file"
  ],
  "canary_allowed": false,
  "canary_blocked": true,
  "evaluator": "event_clustered_walk_forward_v1",
  "folds": [],
  "input": {
    "accepted_book_records": 0,
    "label_records": 0,
    "observation_records": 0
  },
  "input_requirements": {
    "canary_boundary": "These inputs can produce a public replay only; private order/fill/cancel/fee/settlement/account receipts remain required.",
    "evaluation": {
      "complete_chronological_fold": true,
      "embargo_ms": 1000,
      "event_cluster_key": "market_id",
      "minimum_training_events_per_fold": 10,
      "purge_ms": 300000
    },
    "observations": {
      "format": "JSONL",
      "historical_csv_or_midpoint_only": "insufficient",
      "minimum_record": {
        "execution_fields": [
          "books.<token>.asks",
          "books.<token>.bids",
          "rules.tick_size",
          "rules.min_order_size",
          "fees.rate",
          "fees.exponent",
          "fees.asset"
        ],
        "observation_type": "book_snapshot",
        "provenance_fields": [
          "source",
          "capture_id",
          "source_sha256",
          "retrieved_at_ms"
        ],
        "required_fields": [
          "observation_id",
          "source_event_time_ms",
          "received_time_ms",
          "market_id",
          "condition_id",
          "token_ids",
          "books",
          "fees",
          "rules",
          "provenance"
        ]
      },
      "present": false,
      "provided_name": "observations-v3.jsonl",
      "role": "canonical_v3_book_observations"
    },
    "resolution_labels": {
      "format": "JSONL",
      "minimum_record": {
        "availability_rule": "label_available_time_ms >= resolved_time_ms and is after the feature used for prediction",
        "one_record_per": "market_id",
        "outcome_values": [
          "up",
          "down"
        ],
        "required_fields": [
          "condition_id",
          "label_available_time_ms",
          "label_version",
          "market_id",
          "outcome",
          "resolved_time_ms",
          "source",
          "source_sha256"
        ]
      },
      "present": false,
      "provided_name": "resolution-labels.jsonl",
      "public_quote_or_unresolved_market": "insufficient",
      "role": "independent_resolution_labels"
    }
  },
  "metrics": {
    "attempts": 0,
    "brier": null,
    "ece": null,
    "expired_orders": 0,
    "fees_usdc": null,
    "filled_attempts": 0,
    "gross_pnl_usdc": null,
    "net_pnl_usdc": null,
    "net_return_on_filled_cost": null,
    "partial_fills": 0,
    "predictions": 0
  },
  "official_semantics": {
    "fees": "https://docs.polymarket.com/trading/fees",
    "mid_price_fills": "rejected",
    "orders": "https://docs.polymarket.com/trading/place-orders",
    "private_execution_evidence": false
  },
  "schema_version": 1,
  "split_policy": {
    "cluster_key": "market_id",
    "embargo_ms": 1000,
    "fit_cutoff_rule": "received_time_ms < train_end and label_available_time_ms <= train_end",
    "purge_ms": 300000
  }
}
