{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/yt-feng/poly_trade/schema/execution-realism.json",
  "title": "Pre-registered executable-price stress matrix",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "price_source",
    "midpoint_allowed",
    "required_execution_fields",
    "minimum_edge",
    "stress_matrix",
    "cell_count",
    "matrix_sha256",
    "outputs"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "price_source": {"const": "displayed_ask_bid"},
    "midpoint_allowed": {"const": false},
    "required_execution_fields": {"type": "array", "minItems": 6, "uniqueItems": true, "items": {"type": "string"}},
    "minimum_edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["field", "values", "rule", "unit"],
      "properties": {
        "field": {"const": "edge_buffer"},
        "values": {"type": "array", "minItems": 1, "uniqueItems": true},
        "rule": {"const": "predicted_edge > minimum_edge"},
        "unit": {"const": "probability"}
      }
    },
    "stress_matrix": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fee_rate_multiplier", "slippage_ticks", "latency_ms", "depth_fraction", "partial_fill_policy", "ttl_ms"],
      "properties": {
        "fee_rate_multiplier": {"type": "array", "minItems": 1, "uniqueItems": true},
        "slippage_ticks": {"type": "array", "minItems": 1, "uniqueItems": true},
        "latency_ms": {"type": "array", "minItems": 1, "uniqueItems": true},
        "depth_fraction": {"type": "array", "minItems": 1, "uniqueItems": true},
        "partial_fill_policy": {"type": "array", "minItems": 1, "uniqueItems": true},
        "ttl_ms": {"type": "array", "minItems": 1, "uniqueItems": true}
      }
    },
    "cell_count": {"type": "integer", "minimum": 1},
    "matrix_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "outputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["per_cell", "null_on_synthetic"],
      "properties": {
        "per_cell": {
          "const": ["gross_pnl_usdc", "fee_usdc", "net_pnl_usdc", "fill_rate", "brier", "ece"]
        },
        "null_on_synthetic": {"const": true}
      }
    }
  }
}
